# ==========================================
# Messaging Providers (Multi-Channel Adapter)
# ==========================================
# Options: telegram, whatsapp, telegram_user, or both
BROADCAST_PROVIDER=telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather

# ==========================================
# Telegram User Account (Personal Phone via MTProto)
# ==========================================
# Get these free from https://my.telegram.org -> API development tools
TELEGRAM_API_ID=your_api_id_number
TELEGRAM_API_HASH=your_api_hash_string
TELEGRAM_PHONE=+919876543210
TELEGRAM_SESSION_NAME=telegram_user

# ==========================================
# WhatsApp Business Cloud API Credentials
# ==========================================
WHATSAPP_TOKEN=your_test_token_here
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here
WHATSAPP_BUSINESS_ACCOUNT_ID=your_waba_id_here

# ==========================================
# Webhook Verification & Security
# ==========================================
WEBHOOK_VERIFY_TOKEN=choose_any_random_string
APP_SECRET=your_meta_app_secret_here
SECRET_KEY=generate_a_long_random_string

# ==========================================
# Admin Dashboard Authentication
# ==========================================
ADMIN_USERNAME=admin
# Optional bcrypt hash. If empty, defaults to hash for 'admin123'
ADMIN_PASSWORD_HASH=

# ==========================================
# Database Configuration
# ==========================================
# 1. SQLite (Local Development):
DATABASE_URL=sqlite:///./app.db

# 2. Supabase Free PostgreSQL (Production):
# DATABASE_URL=postgresql+psycopg://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 3. Docker Compose (Local Container):
# DATABASE_URL=postgresql+psycopg://wa_user:wa_password@db:5432/wa_broadcaster

# ==========================================
# Safety Simulation Mode
# ==========================================
# true = simulate all sends without contacting Meta
# false = send real WhatsApp messages
DRY_RUN=true
